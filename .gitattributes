# Shell scripts and unit files MUST keep LF endings. A CRLF checkout on Windows
# that is copied to a Linux host fails with
#   bad interpreter: /usr/bin/env bash^M
# which is a confusing way to discover a line-ending problem mid-install.
*.sh            text eol=lf
*.bash          text eol=lf
*.service       text eol=lf
*.conf          text eol=lf

# Compose, cloud-init and config files are read by Linux tooling.
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
.env.example    text eol=lf

# Windows-side tooling keeps CRLF.
*.ps1           text eol=crlf

# Binary — never touch.
*.png           binary
*.gguf          binary
*.bin           binary
*.docx          binary
*.pem           -text
